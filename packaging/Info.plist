<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. scripts/build-app.sh substitutes @VERSION@ and @BUILD@. -->
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>parrot</string>

    <!-- Not com.digimata.parrot: that is upstream's identifier and already the
         LaunchAgent label, and two things called the same name is how you end
         up debugging which one TCC meant. -->
    <key>CFBundleIdentifier</key>
    <string>no.bredebjorhovd.papegoye</string>

    <key>CFBundleName</key>
    <string>Papegøye</string>
    <key>CFBundleDisplayName</key>
    <string>Papegøye</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundleVersion</key>
    <string>@BUILD@</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>

    <!-- Menu bar only: the daemon already runs as .accessory, and a dock icon
         for something you drive with the fn key would be noise. -->
    <key>LSUIElement</key>
    <true/>

    <!-- A bundled app that touches the mic without this key is killed rather
         than prompted. The unbundled binary never needed it. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Papegøye transcribes what you dictate while you hold the fn key. Audio is transcribed on this Mac and never leaves it.</string>

    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSHumanReadableCopyright</key>
    <string>© 2026 Andrew Jones · fork by Brede Bjørhovd. MIT.</string>
</dict>
</plist>
